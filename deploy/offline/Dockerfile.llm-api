# ============================================================
# 私有化交付版 llm-api 镜像（乙方有网环境预构建；院内 docker load 导入）
# 与生产云端同基镜像（python:3.12-alpine），叠加两点私有化增强：
#   ① ffmpeg：音频上传转码兜底（前端直录 16k WAV 不需要；
#      医生上传 mp3/m4a 文件时必需）
#   ② 可选 faster-whisper：--build-arg WITH_LOCAL_ASR=1（方案B 本地引擎；
#      镜像体积 +约 1GB；whisper 模型文件不经镜像，随交付包 models/ 目录挂载）
# 构建：
#   docker build -t mra/llm-api:<版本> -f deploy/offline/Dockerfile.llm-api .
#   docker build -t mra/llm-api:<版本> -f deploy/offline/Dockerfile.llm-api \
#     --build-arg WITH_LOCAL_ASR=1 .
# 由 deploy/offline/make_delivery.sh 自动调用，一般无需手工执行
# ============================================================
ARG BASE=public.ecr.aws/docker/library/python:3.12-alpine
FROM ${BASE}
ARG WITH_LOCAL_ASR=0
RUN apk add --no-cache ffmpeg \
    && if [ "$WITH_LOCAL_ASR" = "1" ]; then pip install --no-cache-dir faster-whisper; fi
WORKDIR /app
EXPOSE 8090
# 代码与密钥全部经 compose 卷挂载进容器（./repo/server:/app:ro 等）；
# 镜像本身零代码、零数据、零密钥
CMD ["python3", "llm_api.py"]
