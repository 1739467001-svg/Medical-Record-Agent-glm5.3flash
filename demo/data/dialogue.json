[
 {
  "role": "医生",
  "text": "您好，请坐。哪里不舒服？",
  "mapsTo": []
 },
 {
  "role": "患者",
  "text": "大夫，俺这右下肚子疼喽一个多月咧，一直隐隐地钝疼，搁当地镇卫生院看了，说阑尾上长了个粪石。",
  "mapsTo": [
   "主诉",
   "发病情况"
  ]
 },
 {
  "role": "医生",
  "text": "疼是持续的还是一阵一阵的？什么时候开始的，有什么诱因吗？",
  "mapsTo": [
   "主要症状特点及其发展变化"
  ]
 },
 {
  "role": "患者",
  "text": "一个月前开始的，也说不上啥原因，一直是持续性钝疼，程度不算重，也不往别处窜。",
  "mapsTo": [
   "发病情况",
   "主要症状特点及其发展变化"
  ]
 },
 {
  "role": "医生",
  "text": "恶心呕吐吗？有没有拉肚子、黑便、脓血便？排便后疼能轻点吗？",
  "mapsTo": [
   "伴随症状"
  ]
 },
 {
  "role": "患者",
  "text": "都没有，拉完也不见轻。",
  "mapsTo": [
   "伴随症状"
  ]
 },
 {
  "role": "医生",
  "text": "发烧、打寒战有过吗？",
  "mapsTo": [
   "伴随症状"
  ]
 },
 {
  "role": "患者",
  "text": "没有。",
  "mapsTo": [
   "伴随症状"
  ]
 },
 {
  "role": "医生",
  "text": "在卫生院是怎么治的？",
  "mapsTo": [
   "发病以来诊治经过及结果"
  ]
 },
 {
  "role": "患者",
  "text": "做了个腹部CT，说阑尾粪石、阑尾炎，吃了口服的消炎药，疼轻了些。可这几天下腹还是不得劲，昨天来咱医院，门诊说收住院做手术。",
  "mapsTo": [
   "发病以来诊治经过及结果"
  ]
 },
 {
  "role": "医生",
  "text": "精神、吃饭、睡觉怎么样？大小便呢？体重有变化吗？",
  "mapsTo": [
   "发病以来一般情况"
  ]
 },
 {
  "role": "患者",
  "text": "都还凑合，吃饭睡觉一般，大小便正常，体重没啥变化。",
  "mapsTo": [
   "精神状态",
   "食欲",
   "睡眠",
   "小便情况",
   "大便情况",
   "体重"
  ]
 },
 {
  "role": "医生",
  "text": "平时身体怎么样？有高血压、心脏病、糖尿病、脑血管病这些吗？",
  "mapsTo": [
   "既往史",
   "疾病史（含外伤）"
  ]
 },
 {
  "role": "患者",
  "text": "平素挺结实，那些都没有。",
  "mapsTo": [
   "健康状况",
   "心血管病史",
   "其他病史"
  ]
 },
 {
  "role": "医生",
  "text": "肝炎、结核这些传染病史呢？做过手术、受过大外伤、输过血吗？",
  "mapsTo": [
   "肝炎结核病史",
   "手术外伤输血"
  ]
 },
 {
  "role": "患者",
  "text": "都没有。",
  "mapsTo": [
   "肝炎结核病史",
   "手术外伤史"
  ]
 },
 {
  "role": "医生",
  "text": "对什么食物、药物过敏吗？",
  "mapsTo": [
   "过敏史"
  ]
 },
 {
  "role": "患者",
  "text": "不过敏。",
  "mapsTo": [
   "过敏史"
  ]
 },
 {
  "role": "医生",
  "text": "预防接种史还记得吗？",
  "mapsTo": [
   "预防接种史"
  ]
 },
 {
  "role": "患者",
  "text": "记不清咧。",
  "mapsTo": [
   "预防接种史"
  ]
 },
 {
  "role": "医生",
  "text": "生在本地吗？抽烟、喝酒吗？",
  "mapsTo": [
   "个人史",
   "生活习惯、烟酒史"
  ]
 },
 {
  "role": "患者",
  "text": "生在本地一直住这儿，不抽烟，也不喝酒。",
  "mapsTo": [
   "居住地",
   "吸烟史",
   "饮酒史"
  ]
 },
 {
  "role": "医生",
  "text": "结婚了没有？",
  "mapsTo": [
   "婚育史"
  ]
 },
 {
  "role": "患者",
  "text": "还没呢。",
  "mapsTo": [
   "婚姻史"
  ]
 },
 {
  "role": "医生",
  "text": "父母身体怎么样？家里有没有遗传倾向的疾病？",
  "mapsTo": [
   "家族史"
  ]
 },
 {
  "role": "患者",
  "text": "父母都健在，有个姐姐也挺健康，家里没有那样的病。",
  "mapsTo": [
   "家族健康状况",
   "有无遗传倾向疾病"
  ]
 }
]